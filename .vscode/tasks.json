{
  "version": "2.0.0",
  "options": {
    "env": {
      "LMS_ENV": "development",
      "DJANGO_DEBUG": "1",
      "POSTGRES_DB": "",
      "INSTITUTION_ID": "demo",
      "DEFAULT_CAMPUS": "main",
      "PYTHONUNBUFFERED": "1"
    }
  },
  "tasks": [
    {
      "label": "Admiezo: Migrate local database",
      "type": "process",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "args": ["manage.py", "migrate", "--noinput"],
      "options": {"cwd": "${workspaceFolder}/backend"},
      "problemMatcher": []
    },
    {
      "label": "Admiezo: Backend",
      "type": "process",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "args": ["-u", "manage.py", "runserver", "127.0.0.1:8017"],
      "options": {"cwd": "${workspaceFolder}/backend"},
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {"panel": "dedicated", "group": "admiezo", "reveal": "always"},
      "runOptions": {"instanceLimit": 1}
    },
    {
      "label": "Admiezo: Frontend",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "dev"],
      "options": {"cwd": "${workspaceFolder}/frontend"},
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {"panel": "dedicated", "group": "admiezo", "reveal": "always"},
      "runOptions": {"instanceLimit": 1}
    },
    {
      "label": "Admiezo: Quiz expiry worker",
      "type": "process",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "args": ["-u", "manage.py", "expire_attempts", "--watch"],
      "options": {"cwd": "${workspaceFolder}/backend"},
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {"panel": "dedicated", "group": "admiezo", "reveal": "always"},
      "runOptions": {"instanceLimit": 1}
    },
    {
      "label": "Admiezo: Start services",
      "dependsOn": ["Admiezo: Backend", "Admiezo: Frontend", "Admiezo: Quiz expiry worker"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Admiezo: Run all",
      "dependsOn": ["Admiezo: Migrate local database", "Admiezo: Start services"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
