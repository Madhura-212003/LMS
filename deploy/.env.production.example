# Copy to .env.production on the IT-managed host. Never commit actual values.
LMS_ENV=production
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=backend,localhost,127.0.0.1,lms.example.org
PUBLIC_APP_URL=https://lms.example.org
LMS_DOMAIN=lms.example.org
LMS_BACKEND_IMAGE=
LMS_FRONTEND_IMAGE=

POSTGRES_DB=admiezo
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=require
REDIS_URL=

ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_API_AUDIENCE=
INSTITUTION_ID=
DEFAULT_CAMPUS=main
LMS_TIME_ZONE=Asia/Kolkata
# Override these only when using Entra External ID/custom authority metadata.
# ENTRA_AUTHORITY=https://login.microsoftonline.com/TENANT_ID
# ENTRA_ISSUER=https://login.microsoftonline.com/TENANT_ID/v2.0
# ENTRA_JWKS_URL=https://login.microsoftonline.com/TENANT_ID/discovery/v2.0/keys

AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER=learning-private
# Azure VM managed identity is preferred. For a non-Azure host, supply a
# dedicated workload/service principal through Azure's standard credential env.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
MAX_UPLOAD_BYTES=536870912
CLAMAV_HOST=
CLAMAV_PORT=3310

AI_PROVIDER=gemini
AI_MODEL=
AI_API_KEY=
EXECUTION_SERVICE_URL=
EXECUTION_SERVICE_TOKEN=
JITSI_BASE_URL=
JITSI_JWT_APP_ID=
JITSI_JWT_SECRET=
